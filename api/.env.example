DATABASE_URL="postgresql://identidad:identidad@localhost:5432/identidad_dev?schema=public"
PORT=3001
SESSION_COOKIE_NAME=idsid
NODE_ENV=development
SEED_ADMIN_EMAIL=admin@identidad.local
SEED_ADMIN_PASSWORD=Cambiar123!
STORAGE_DRIVER=local
STORAGE_DIR=var/storage
# Solo si STORAGE_DRIVER=r2. Crear bucket + API token en el dashboard de Cloudflare R2.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=identidad-digital-ine
# 32 bytes en base64 para AES-256-GCM. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INE_ENCRYPTION_KEY=
EMAIL_DRIVER=dev
WEB_URL=http://localhost:3000

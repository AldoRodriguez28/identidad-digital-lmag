generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  admin
  gestor
}

enum PrincipalType {
  internal_user
  student
}

model InternalUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Session {
  id            String        @id @default(cuid())
  principalType PrincipalType
  principalId   String
  expiresAt     DateTime
  remember      Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([principalType, principalId])
}
